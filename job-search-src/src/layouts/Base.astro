---
import '../styles/global.css';
import { useT, href, base, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Route without language prefix, e.g. "/" or "/method". */
  route: string;
  title?: string;
  description?: string;
}
const { lang, route, title, description } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'fr' : 'en';
const pageTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
const desc = description ?? t('site.desc');
const abs = (p: string) => new URL(p, Astro.site).toString();
const nav = [
  { route: '/', key: 'nav.profile' },
  { route: '/territories', key: 'nav.territories' },
  { route: '/method', key: 'nav.method' },
  { route: '/sources', key: 'nav.sources' },
] as const;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(href(lang, route))} />
    <link rel="alternate" hreflang="en" href={abs(href('en', route))} />
    <link rel="alternate" hreflang="fr" href={abs(href('fr', route))} />
    <link rel="alternate" hreflang="x-default" href={abs(href('en', route))} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={abs(href(lang, route))} />
    <meta property="og:locale" content={lang === 'en' ? 'en_CA' : 'fr_FR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="top">
      <div class="container bar">
        <p class="brand">
          <a href="/">Erwan Bargain</a> <span>/</span> <a class="sub" href={href(lang, '/')}>{t('site.short')}</a>
        </p>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={href(lang, n.route)} aria-current={n.route === route ? 'page' : undefined}>{t(n.key)}</a>
          ))}
        </nav>
        <a class="lang" href={href(other, route)} hreflang={other} lang={other} aria-label={t('nav.switchLabel')}>
          {t('nav.switch')}
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="container">
        <p>{t('footer.by')} {t('footer.note')}</p>
        <p><a href="https://erwanbargain.com">{t('footer.main')}</a></p>
      </div>
    </footer>
  </body>
</html>

<style>
  .top { border-bottom: 1px solid var(--line); background: var(--bg); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; gap: 24px; height: 56px; font-size: 14px; }
  .brand { margin: 0; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
  .brand a { text-decoration: none; }
  .brand span, .brand .sub { color: var(--muted); font-weight: 400; }
  .brand .sub:hover { color: var(--accent); }
  nav { display: flex; gap: 22px; margin-left: auto; }
  nav a { text-decoration: none; color: var(--muted); padding: 4px 0; border-bottom: 1px solid transparent; }
  nav a:hover { color: var(--fg); }
  nav a[aria-current='page'] { color: var(--fg); border-bottom-color: var(--fg); }
  .lang {
    font: 500 12px var(--font-num); text-decoration: none; border: 1px solid var(--line-strong);
    border-radius: var(--radius); padding: 5px 10px; white-space: nowrap;
  }
  .lang:hover { border-color: var(--accent); }
  .foot { border-top: 1px solid var(--line); padding: 28px 0 40px; font-size: 13px; color: var(--muted); }
  .foot .container { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  @media (max-width: 720px) {
    .bar { height: auto; padding-top: 12px; padding-bottom: 10px; flex-wrap: wrap; gap: 8px 16px; }
    nav { order: 3; width: 100%; margin-left: 0; gap: 18px; overflow-x: auto; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    .lang { margin-left: auto; }
  }
</style>
