---
import Base from '../layouts/Base.astro';
import { useT, href, type Lang, type Key } from '../i18n/ui';
import { ages, edus, territories, values, sources, meta } from '../data/study';
import { findings } from '../data/findings';
import { cities, unempKind, rentKind, fmtRent } from '../data/cities';
import { gains, placeName } from '../data/gains';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const fr = lang === 'fr';

const cityRows = cities.map((c) => ({
  t: c.territory,
  n: c.name[lang],
  u: c.unemp.v,
  k: unempKind[c.unemp.kind][lang],
  r: c.rent ? `${fmtRent(c, lang)} · ${rentKind[c.rent.kind][lang]}` : '',
}));

// What is left after tax and rent, for the reference city of each territory (median wage).
// `eur` is the same amount in euros at French prices (OECD purchasing power parities): the
// single unit used to rank territories across currencies.
const cash = Object.fromEntries(
  gains.after
    .filter((r) => r.main && r.territory && r.ppp != null)
    .map((r) => [
      r.territory,
      {
        city: placeName(r.name, lang, true),
        left: r.left,
        cur: r.currency,
        // Canadian cities: also divided by the city's price level excluding housing (Statistics Canada, October 2019).
        eur: Math.round((r.ppp! * gains.eurPerUsdPpp) / ((r.priceIdx ?? 100) / 100)),
        share: Math.round(r.share),
        weak: r.rentKind === 'sitting' || r.rentKind === 'median' || r.caveats.includes('otherConcept'),
      },
    ]),
);

// "+4 %": how much dearer a city is than the average of Canadian cities, housing excluded.
const pricePct = (city: string) => {
  const idx = gains.after.find((r) => r.name === city)?.priceIdx ?? 100;
  const pct = Math.round(idx - 100);
  return `${pct >= 0 ? '+' : '−'}${Math.abs(pct)}${fr ? ' %' : '%'}`;
};

// Main language at work, summarised from the study's findings.
const L = (en: string, frText: string, level: 'fr' | 'mix' | 'en') => ({ text: fr ? frText : en, level });
const language = (id: string, country: string) =>
  id === 'BE1' ? L('French; Dutch often required', 'Français ; néerlandais souvent exigé', 'mix')
  : id === 'LU00' ? L('French, plus English or German', 'Français, plus anglais ou allemand', 'mix')
  : id === 'CH02' ? L('Mostly German', 'Surtout allemand', 'en')
  : id === 'CA-QC' ? L('French; English often asked in Montréal', 'Français ; anglais souvent demandé à Montréal', 'fr')
  : id === 'CA-NB' ? L('French in the north, English elsewhere', 'Français au nord, anglais ailleurs', 'mix')
  : country === 'CA' ? L('English', 'Anglais', 'en')
  : L('French', 'Français', 'fr');

const payload = {
  lang,
  territories: territories.map((x) => ({
    id: x.id,
    name: x.name[lang],
    country: x.country,
    prog: !!x.prog,
    open: !!x.open,
    mixed: !!x.mixed,
    cash: cash[x.id] ?? null,
    language: language(x.id, x.country),
  })),
  values,
  sources,
  cities: cityRows,
  text: {
    cities: t('panel.cities'),
    missing: t('panel.missing'),
    source: t('panel.source'),
    period: t('panel.period'),
    programme: t('panel.programme'),
    q: { u: t('q.u'), calc: t('q.calc'), avg: t('q.avg'), model: t('q.model') },
    open: t('note.open'),
    caEdu: t('note.caEdu'),
    mixed: t('note.mixed'),
    age: Object.fromEntries(ages.map((a) => [a, t(`age.${a}` as Key)])),
    edu: Object.fromEntries(edus.map((e) => [e, t(`edu.${e}` as Key)])),
    cashIn: fr ? 'à' : 'in',
    cashSub: fr ? 'après impôt et loyer, au salaire médian' : 'after tax and rent, at the median wage',
    cashEq: fr ? 'soit environ' : 'about',
    cashEq2: fr ? 'à prix français' : 'at French prices',
    cashNone: fr ? 'non calculé pour ce territoire' : 'not computed for this territory',
    cashWeak: fr ? 'base plus fragile' : 'weaker basis',
    np: fr ? 'n.p.' : 'n/p',
    npTitle: fr ? "non publié : la note d'emploi repose sur le chômage seul" : 'not published: the job score rests on unemployment alone',
    none: fr ? 'non publié' : 'not published',
    top: fr ? 'En tête pour cet objectif :' : 'Top of the ranking for this objective:',
    yours: fr ? 'Votre territoire' : 'Your territory',
    rank: fr ? 'rang' : 'rank',
    of: fr ? 'sur' : 'of',
    unranked: fr ? 'non classé, donnée manquante' : 'not ranked, figure missing',
    hidden: fr ? 'territoires où le français n’est pas la langue de travail sont masqués.' : 'territories where French is not the working language are hidden.',
  },
};
const countries = ['FR', 'BE', 'LU', 'CH', 'CA'] as const;
const countryName: Record<string, { en: string; fr: string }> = {
  FR: { en: 'France', fr: 'France' },
  BE: { en: 'Belgium', fr: 'Belgique' },
  LU: { en: 'Luxembourg', fr: 'Luxembourg' },
  CH: { en: 'Switzerland', fr: 'Suisse' },
  CA: { en: 'Canada', fr: 'Canada' },
};
const objectives = [
  { id: 'all', t: fr ? 'Le meilleur compromis' : 'The best all-round', s: fr ? 'moitié argent, moitié emploi' : 'half money, half job' },
  { id: 'left', t: fr ? 'Garder le plus après le loyer' : 'Keep the most after rent', s: fr ? 'reste par mois, en euros à prix français' : 'left each month, in euros at French prices' },
  { id: 'job', t: fr ? 'Trouver facilement un emploi' : 'Find a job easily', s: fr ? 'chômage pour votre profil et durée des recherches' : 'unemployment for your profile and length of searches' },
];
const h = {
  step1: fr ? 'Votre profil' : 'Your profile',
  step2: fr ? 'Votre objectif principal' : 'Your main objective',
  step3: fr ? 'Le classement' : 'The ranking',
  langLabel: fr ? 'Langue de travail' : 'Working language',
  langAny: fr ? 'Peu importe' : 'Any',
  langFr: fr ? 'Français' : 'French',
  tile1: fr ? 'Reste par mois' : 'Left each month',
  tile2: fr ? 'Chômage, votre profil' : 'Unemployment, your profile',
  tile3: fr ? 'Cherchent depuis un an ou plus' : 'Searching for a year or more',
  tile3sub: fr ? 'part des chômeurs, tous profils' : 'share of the unemployed, all profiles',
  today: fr ? 'Là où vous êtes' : 'Where you are now',
  cRank: '#',
  cTerr: fr ? 'Territoire' : 'Territory',
  cAll: fr ? 'Synthèse' : 'Overall',
  cAllSub: fr ? 'note sur 100' : 'score out of 100',
  cLeft: fr ? 'Reste par mois' : 'Left each month',
  cLeftSub: fr ? 'euros, prix français' : 'euros, French prices',
  cShare: fr ? 'Loyer / net' : 'Rent / net pay',
  cUnemp: fr ? 'Chômage' : 'Unemployment',
  cUnempSub: fr ? 'votre profil' : 'your profile',
  cLtu: fr ? 'Un an ou plus' : 'A year or more',
  cLtuSub: fr ? 'de recherche' : 'of searching',
  cLang: fr ? 'Langue au travail' : 'Language at work',
  note1: fr
    ? "Synthèse : la note pèse à parts égales l'argent (ce qui reste après le loyer) et l'emploi (le chômage pour votre profil et la part des recherches d'un an ou plus). Sur chaque critère, les territoires sont classés du meilleur au moins bon ; la note est la moyenne de ces positions, ramenée sur 100. C'est une règle simple choisie pour cette page, pas un indice officiel : d'autres poids donneraient un autre ordre. « Trouver facilement un emploi » classe sur les deux critères d'emploi seuls. La part des recherches d'un an ou plus n'est pas publiée (n.p.) pour la Corse, le Yukon, les Territoires du Nord-Ouest et le Nunavut : leur note d'emploi repose sur le chômage seul. La colonne « loyer / net » est donnée pour information."
    : 'Overall: the score weighs money (what is left after rent) and job (unemployment for your profile and the share of searches lasting a year or more) equally. On each criterion, territories are ranked from best to worst; the score is the average of those positions, scaled to 100. It is a simple rule chosen for this page, not an official index: other weights would give another order. “Find a job easily” ranks on the two job criteria alone. The share of searches lasting a year or more is not published (n/p) for Corsica, Yukon, the Northwest Territories and Nunavut: their job score rests on unemployment alone. The “rent / net pay” column is given for information.',
  note2: fr
    ? `Reste par mois : notre calcul, pour une personne seule au salaire médian, dans la ville de référence. Il est converti en euros à prix français avec les parités de pouvoir d'achat de l'OCDE (2024) : ce que la somme permettrait d'acheter en France. Le montant en monnaie locale figure dessous. Entre pays, à lire comme un ordre de grandeur. † base plus fragile : loyer des locataires en place, loyer repris de la presse ou autre définition du salaire. Au Canada, le montant tient aussi compte des écarts de prix hors logement entre villes (Statistique Canada, octobre 2019) : ${pricePct('Whitehorse')} à Whitehorse, ${pricePct('Yellowknife')} à Yellowknife ; à Iqaluit, seule l'alimentation est mesurée, la correction (${pricePct('Iqaluit')}) est donc un minimum. Pour ces trois territoires, le chiffre reste favorable : le salaire retenu est celui des personnes à temps plein toute l'année.`
    : `Left each month: our computation, for a single person at the median wage, in the reference city. It is converted into euros at French prices with OECD purchasing power parities (2024): what the amount would buy in France. The amount in local currency is shown underneath. Across countries, read it as an order of magnitude. † weaker basis: rent of sitting tenants, press-reported rent or a different wage definition. In Canada the amount also allows for price differences between cities, housing excluded (Statistics Canada, October 2019): ${pricePct('Whitehorse')} in Whitehorse, ${pricePct('Yellowknife')} in Yellowknife; in Iqaluit only food is measured, so the correction (${pricePct('Iqaluit')}) is a minimum. For these three territories the figure stays on the favourable side: the wage used is that of people working full time all year.`,
  note3: fr
    ? `Chômage : Eurostat et Statistique Canada, 2025. Le droit au travail, la langue et le métier passent avant tout classement. * fiabilité faible · ~ estimé : les enquêtes ne publient pas un taux quand trop peu de personnes de cet âge et de ce diplôme ont été interrogées dans le territoire ; la case est alors reconstituée à partir des taux publiés du territoire et de la structure nationale par âge et diplôme. Testée sur les cases publiées, cette méthode s'écarte de ${String(meta.modelCheck.medianGap).replace('.', ',')} point en valeur médiane, et de moins de ${String(meta.modelCheck.p90Gap).replace('.', ',')} points neuf fois sur dix.`
    : `Unemployment: Eurostat and Statistics Canada, 2025. The right to work, the language and the occupation come before any ranking. * low reliability · ~ estimated: surveys publish no rate when too few people of that age and education were interviewed in the territory; the cell is then rebuilt from the territory's published rates and the national pattern by age and education. Tested on published cells, the method is off by ${meta.modelCheck.medianGap} point at the median, and by less than ${meta.modelCheck.p90Gap} points nine times out of ten.`,
  more: fr ? 'Voir le détail du reste après loyer' : 'See the detail of what is left after rent',
  before: fr ? 'Avant de partir : santé, congés, retraite' : 'Before you move: health, leave, pension',
};
---
<Base lang={lang} route="/">
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{t('hero.eyebrow')}</p>
      <h1>{t('hero.title.a')}<span class="accent">{t('hero.title.em')}</span>{t('hero.title.b')}</h1>
      <p class="lead">{t('hero.lead')}</p>

      <form id="picker" onsubmit="return false">
        <div class="steps-grid">
          <fieldset class="step-box">
            <legend><span class="num sn">1</span>{h.step1}</legend>
            <div class="picker">
              <label>
                <span>{t('picker.age')}</span>
                <select name="age">
                  {ages.map((a) => <option value={a} selected={a === '25-54'}>{t(`age.${a}` as Key)}</option>)}
                </select>
              </label>
              <label>
                <span>{t('picker.edu')}</span>
                <select name="edu">
                  {edus.map((e) => <option value={e} selected={e === 'high'}>{t(`edu.${e}` as Key)}</option>)}
                </select>
              </label>
              <label>
                <span>{t('picker.zone')}</span>
                <select name="zone">
                  {countries.map((c) => (
                    <optgroup label={countryName[c][lang]}>
                      {territories.filter((x) => x.country === c).map((x) => (
                        <option value={x.id} selected={x.id === 'FR1'}>{x.name[lang]}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
              </label>
              <label>
                <span>{h.langLabel}</span>
                <select name="wlang">
                  <option value="any" selected>{h.langAny}</option>
                  <option value="fr">{h.langFr}</option>
                </select>
              </label>
            </div>
          </fieldset>

          <fieldset class="step-box">
            <legend><span class="num sn">2</span>{h.step2}</legend>
            <div class="goals">
              {objectives.map((o, k) => (
                <label class="goal">
                  <input type="radio" name="goal" value={o.id} checked={k === 0} />
                  <span class="gt">{o.t}</span>
                  <span class="gs">{o.s}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>
      </form>
    </div>
  </section>

  <section class="section rank-section" id="ranking">
    <div class="container">
      <h2><span class="num sn dark">3</span>{h.step3}</h2>
      <p class="short" id="s-short"></p>
      <div class="table-wrap">
        <table class="data syn">
          <thead>
            <tr>
              <th class="rk">{h.cRank}</th>
              <th>{h.cTerr}</th>
              <th class="r" data-col="all">{h.cAll}<span>{h.cAllSub}</span></th>
              <th class="r" data-col="left">{h.cLeft}<span>{h.cLeftSub}</span></th>
              <th class="r" data-col="share">{h.cShare}</th>
              <th class="r" data-col="unemp">{h.cUnemp}<span>{h.cUnempSub}</span></th>
              <th class="r" data-col="ltu">{h.cLtu}<span>{h.cLtuSub}</span></th>
              <th>{h.cLang}</th>
            </tr>
          </thead>
          <tbody id="s-rows"></tbody>
        </table>
      </div>
      <p class="legend syn-note" id="s-hidden"></p>
      <p class="legend syn-note">{h.note1}</p>
      <p class="legend syn-note">{h.note2}</p>
      <p class="legend syn-note"><i class="prog-dot"></i> {t('legend.prog')}. {h.note3}</p>
      <p class="actions">
        <a class="btn" href={href(lang, '/gains')}>{h.more}</a>
        <a class="btn ghost" href={href(lang, '/moving')}>{h.before}</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container today">
      <div>
        <p class="eyebrow">{h.today}</p>
        <h2 id="r-for"></h2>
        <ul class="notes" id="r-notes"></ul>
        <p class="src num" id="r-src"></p>
      </div>
      <div class="panel result" aria-live="polite">
        <div class="tiles">
          <div class="tile first">
            <p class="tl">{h.tile1}</p>
            <p class="tv num" id="t-cash">–</p>
            <p class="ts" id="t-cash-sub"></p>
          </div>
          <div class="tile">
            <p class="tl">{h.tile2}</p>
            <p class="tv num"><span id="t-unemp">–</span><small>%</small></p>
            <p class="ts" id="t-unemp-sub"></p>
          </div>
          <div class="tile">
            <p class="tl">{h.tile3}</p>
            <p class="tv num"><span id="t-ltu">–</span><small>%</small></p>
            <p class="ts">{h.tile3sub}</p>
          </div>
        </div>
        <div class="cities" id="r-cities" hidden>
          <p class="rank-title" id="r-cities-title"></p>
          <ul class="city-rows" id="r-city-rows"></ul>
          <p class="legend">{t('panel.citiesNote')} <a href={href(lang, '/cities')}>{t('panel.citiesAll')} →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">{fr ? 'Résultats' : 'Findings'}</p>
      <h2>{fr ? 'Six constats, chacun avec sa source' : 'Six findings, each with its source'}</h2>
      <div class="grid-3 findings">
        {findings.map((f) => (
          <article class="finding">
            <p class="fig num">{fr ? f.figure.replace('.', ',') : f.figure.replace(' %', '%')}</p>
            <h3>{f.title[lang]}</h3>
            <p class="muted">{f.text[lang]}</p>
            <p class="fsrc num">{f.source[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">{t('home.limits.eyebrow')}</p>
      <h2>{t('home.limits.title')}</h2>
      <p class="lead">{t('home.limits.p')}</p>
      <p class="actions">
        <a class="btn" href={href(lang, '/method')}>{t('cta.method')}</a>
        <a class="btn ghost" href={href(lang, '/territories')}>{t('cta.territories')}</a>
      </p>
    </div>
  </section>

  <script type="application/json" id="study-data" set:html={JSON.stringify(payload)} />
</Base>

<script>
  type V = { t: string; i: string; a: string; e: string; v: number; p: string; s: string; q: string };
  type Crit = 'left' | 'share' | 'unemp' | 'ltu';
  type Row = { x: any; val: Record<Crit, number | null>; unemp: V | null; pos: Partial<Record<Crit, number>>; cls: Partial<Record<Crit, string>>; score: number | null; used: number };
  const data = JSON.parse(document.getElementById('study-data')!.textContent!);
  const form = document.getElementById('picker') as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const nf = new Intl.NumberFormat(data.lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const n0 = new Intl.NumberFormat(data.lang, { maximumFractionDigits: 0 });
  const money = (v: number, cur: string) => (data.lang === 'fr' ? `${n0.format(v)} ${cur === 'EUR' ? '€' : cur}` : `${cur === 'EUR' ? '€' : cur + ' '}${n0.format(v)}`);
  const short = (name: string) => name.replace(/\s*\(.*\)/, '');
  const el = (tag: string, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  };

  const index = new Map<string, V>();
  for (const v of data.values as V[]) index.set(`${v.t}|${v.i}|${v.a}|${v.e}`, v);

  /** Exact profile first, then the closest published level. */
  function lookup(t: string, i: string, a: string, e: string): { v: V; exact: boolean } | null {
    const tries: [string, string][] = [[a, e], ['all', e], [a, 'all'], ['all', 'all']];
    for (let k = 0; k < tries.length; k++) {
      const hit = index.get(`${t}|${i}|${tries[k][0]}|${tries[k][1]}`);
      if (hit) return { v: hit, exact: k === 0 };
    }
    return null;
  }

  const CRITS: Crit[] = ['left', 'share', 'unemp', 'ltu'];
  const higherIsBetter: Record<Crit, boolean> = { left: true, share: false, unemp: false, ltu: false };

  function render() {
    const fd = new FormData(form);
    const a = String(fd.get('age')), e = String(fd.get('edu')), zone = String(fd.get('zone'));
    const goal = String(fd.get('goal')) as 'all' | 'left' | 'job';
    const frenchOnly = fd.get('wlang') === 'fr';
    const terr = data.territories.find((x: any) => x.id === zone);
    const mine = lookup(zone, 'unemp', a, e);
    const myLtu = index.get(`${zone}|ltu|all|all`);

    // ---- ranking ----
    // Compare like with like: the same profile level as the one available for the reader's territory.
    const level = mine ? [mine.v.a, mine.v.e] : [a, e];
    const all: Row[] = data.territories.map((x: any) => {
      const unemp = index.get(`${x.id}|unemp|${level[0]}|${level[1]}`) ?? null;
      return {
        x,
        unemp,
        val: { left: x.cash?.eur ?? null, share: x.cash?.share ?? null, unemp: unemp?.v ?? null, ltu: index.get(`${x.id}|ltu|all|all`)?.v ?? null },
        pos: {},
        cls: {},
        score: null,
        used: 0,
      };
    });
    // The reader's own territory always stays in the table, even when the language filter would hide it.
    const rows = all.filter((r) => !frenchOnly || r.x.language.level !== 'en' || r.x.id === zone);
    const hidden = all.length - rows.length;

    for (const c of CRITS) {
      const have = rows.filter((r) => r.val[c] != null).sort((p, q) => (higherIsBetter[c] ? q.val[c]! - p.val[c]! : p.val[c]! - q.val[c]!));
      for (const r of have) {
        // Position between 0 (best) and 1 (worst); ties share the position of the first.
        const first = have.findIndex((o) => o.val[c] === r.val[c]);
        r.pos[c] = have.length > 1 ? first / (have.length - 1) : 0;
        r.cls[c] = r.pos[c]! <= 1 / 3 ? 'good' : r.pos[c]! >= 2 / 3 ? 'bad' : '';
      }
    }
    const jobPos = (r: Row) => (r.pos.unemp == null ? null : r.pos.ltu == null ? r.pos.unemp : (r.pos.unemp + r.pos.ltu) / 2);
    for (const r of rows) {
      // Overall: half money (what is left after rent), half job (unemployment for the profile and long searches).
      // Where the share of long searches is not published, the job half rests on unemployment alone.
      const job = jobPos(r);
      r.used = job != null && r.pos.left != null ? (r.pos.ltu != null ? 3 : 2) : 0;
      r.score = r.used ? Math.round(100 * (1 - (r.pos.left! + job!) / 2)) : null;
    }

    // "Find a job easily" averages the positions on unemployment for the profile and on long searches.
    const jobScore = (r: Row) => (jobPos(r) != null ? 100 * (1 - jobPos(r)!) : null);
    const key = (r: Row) => (goal === 'all' ? r.score : goal === 'job' ? jobScore(r) : r.val[goal]);
    const desc = true;
    const isAct = (col: string) => col === goal || (goal === 'job' && (col === 'unemp' || col === 'ltu'));
    rows.sort((p, q) => {
      const pv = key(p), qv = key(q);
      if (pv == null && qv == null) return short(p.x.name).localeCompare(short(q.x.name));
      if (pv == null) return 1;
      if (qv == null) return -1;
      return desc ? qv - pv : pv - qv;
    });
    const ranked = rows.filter((r) => key(r) != null);

    const max = {
      left: Math.max(...rows.map((r) => r.val.left ?? 0), 1),
      share: Math.max(...rows.map((r) => r.val.share ?? 0), 1),
      unemp: Math.max(...rows.map((r) => r.val.unemp ?? 0), 1),
      ltu: Math.max(...rows.map((r) => r.val.ltu ?? 0), 1),
    };
    const cell = (col: string, text: string, ratio: number | null, cls: string, sub?: string, title?: string) => {
      const td = el('td', `r ${cls}${isAct(col) ? ' act' : ''}`);
      td.append(el('span', 'num cv', text));
      if (sub) td.append(el('span', 'csub', sub));
      if (ratio != null) {
        const bar = el('span', 'cbar');
        const fill = el('i');
        fill.style.width = `${Math.round(ratio * 100)}%`;
        bar.append(fill);
        td.append(bar);
      }
      if (title) td.title = title;
      return td;
    };
    const na = (col: string) => cell(col, '–', null, 'na');

    $('s-rows').replaceChildren(
      ...rows.map((r) => {
        const tr = el('tr', r.x.id === zone ? 'me' : '');
        const pos = ranked.indexOf(r);
        const name = el('td', 'tname');
        name.append(el('span', 'tn', short(r.x.name)));
        if (r.x.prog) {
          const dot = el('i', 'prog-dot');
          dot.title = data.text.programme;
          name.append(dot);
        }
        if (r.x.cash) name.append(el('span', 'tc', r.x.cash.city + (r.x.cash.weak ? ' †' : '')));
        const q = r.unemp?.q;
        const mark = q === 'u' ? '*' : q === 'model' ? '~' : '';
        tr.append(
          el('td', 'rk num', pos >= 0 ? String(pos + 1) : '–'),
          name,
          r.score != null ? cell('all', String(r.score), r.score / 100, '') : na('all'),
          r.x.cash ? cell('left', money(r.x.cash.eur, 'EUR'), r.val.left! / max.left, r.cls.left ?? '', r.x.cash.cur === 'EUR' ? undefined : money(r.x.cash.left, r.x.cash.cur)) : na('left'),
          r.val.share != null ? cell('share', data.lang === 'fr' ? `${r.val.share} %` : `${r.val.share}%`, r.val.share / max.share, r.cls.share ?? '') : na('share'),
          r.unemp ? cell('unemp', nf.format(r.unemp.v) + mark, r.unemp.v / max.unemp, r.cls.unemp ?? '', undefined, q && q !== 'ok' ? data.text.q[q] : undefined) : na('unemp'),
          r.val.ltu != null ? cell('ltu', nf.format(r.val.ltu), r.val.ltu / max.ltu, r.cls.ltu ?? '') : cell('ltu', data.text.np, null, 'na', undefined, data.text.npTitle),
          el('td', `lang ${r.x.language.level}`, r.x.language.text),
        );
        return tr;
      }),
    );
    document.querySelectorAll<HTMLElement>('.syn th[data-col]').forEach((th) => th.classList.toggle('act', isAct(th.dataset.col!)));

    const top = ranked.slice(0, 3).map((r) => short(r.x.name) + (r.x.language.level === 'fr' ? '' : ` (${data.lang === 'fr' ? r.x.language.text.toLowerCase() : r.x.language.text})`));
    const myPos = ranked.findIndex((r) => r.x.id === zone);
    const colon = data.lang === 'fr' ? ' : ' : ': ';
    const mineText = `${data.text.yours}, ${short(terr.name)}${colon}${myPos >= 0 ? `${data.text.rank} ${myPos + 1} ${data.text.of} ${ranked.length}` : data.text.unranked}.`;
    $('s-short').textContent = `${data.text.top} ${top.join(', ')}. ${mineText}`;
    $('s-hidden').textContent = hidden ? `${hidden} ${data.text.hidden}` : '';

    // ---- where the reader is now ----
    $('r-for').textContent = short(terr.name);
    const c = terr.cash;
    $('t-cash').textContent = c ? money(c.left, c.cur) : '–';
    $('t-cash-sub').textContent = c
      ? `${data.text.cashIn} ${c.city}, ${data.text.cashSub}${c.cur === 'EUR' ? '' : ` · ${data.text.cashEq} ${money(c.eur, 'EUR')} ${data.text.cashEq2}`}${c.weak ? ` · ${data.text.cashWeak} †` : ''}`
      : data.text.cashNone;
    $('t-unemp').textContent = mine ? nf.format(mine.v.v) : '–';
    const subs: string[] = [];
    if (mine && !mine.exact) subs.push(`${data.text.missing} ${data.text.age[mine.v.a]}, ${data.text.edu[mine.v.e].toLowerCase()}.`);
    if (mine && data.text.q[mine.v.q]) subs.push(data.text.q[mine.v.q]);
    if (!mine) subs.push(data.text.none);
    $('t-unemp-sub').textContent = subs.join(' ');
    $('t-ltu').textContent = myLtu ? nf.format(myLtu.v) : '–';

    const notes: string[] = [];
    if (terr.open) notes.push(data.text.open);
    if (terr.mixed) notes.push(data.text.mixed);
    if (terr.country === 'CA' && e === 'high') notes.push(data.text.caEdu);
    $('r-notes').replaceChildren(...notes.map((n) => el('li', '', n)));

    const local = (data.cities as any[]).filter((x) => x.t === zone).sort((p, q) => p.u - q.u);
    $('r-cities').hidden = !local.length;
    $('r-cities-title').textContent = `${data.text.cities} ${short(terr.name)}`;
    $('r-city-rows').replaceChildren(
      ...local.map((x) => {
        const li = el('li');
        const name = el('span', 'name', x.n);
        name.title = x.n;
        const val = el('span', 'v num', nf.format(x.u));
        val.title = x.k;
        li.append(name, el('span', 'rent', x.r), val);
        return li;
      }),
    );

    const src = $('r-src');
    src.replaceChildren();
    if (mine) {
      const s = data.sources[mine.v.s];
      const link = el('a', '', s.label) as HTMLAnchorElement;
      link.href = s.url;
      link.rel = 'noopener';
      // Periods are stored in English; French uses T for quarters and its own month abbreviations.
      const period = data.lang === 'fr' ? mine.v.p.replace(/^Q(\d)/, 'T$1').replace('Nov ', 'nov. ').replace('Oct ', 'oct. ') : mine.v.p;
      src.append(data.text.source + colon, link, ` · ${data.text.period}${colon}${period}`);
    }
  }

  form.addEventListener('change', render);
  render();
</script>

<style>
  .hero {
    background-image: linear-gradient(var(--track) 1px, transparent 1px), linear-gradient(90deg, var(--track) 1px, transparent 1px);
    background-size: 56px 56px; background-position: center top;
    padding: clamp(36px, 6vw, 68px) 0 clamp(28px, 4vw, 44px);
  }
  .hero .eyebrow { margin-bottom: 16px; }
  .hero h1 { margin-bottom: 16px; max-width: 22ch; }
  .hero .lead { margin-bottom: 28px; max-width: 62ch; }

  .steps-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 16px; align-items: stretch; }
  .step-box { margin: 0; padding: 16px 18px 18px; border: 1px solid var(--line-strong); border-radius: var(--radius-lg); background: var(--panel); min-width: 0; }
  .step-box legend { padding: 0 8px; margin-left: -8px; font: 600 15px var(--font-display); letter-spacing: -0.01em; display: flex; align-items: center; gap: 8px; }
  .sn { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 12px; font-weight: 500; letter-spacing: 0; }
  .sn.dark { margin-right: 10px; vertical-align: 4px; }

  .picker { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .picker label { display: block; border: 1px solid var(--line-strong); border-radius: var(--radius); padding: 7px 12px 6px; min-width: 0; }
  .picker label:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .picker span { display: block; font-size: 11.5px; color: var(--muted); }
  .picker select {
    width: 100%; border: 0; background: transparent; font: 500 15px var(--font-ui); color: var(--fg);
    padding: 2px 0 3px; margin-left: -3px; cursor: pointer; outline: none; text-overflow: ellipsis;
  }

  .goals { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 8px; }
  .goal { position: relative; display: block; border: 1px solid var(--line-strong); border-radius: var(--radius); padding: 9px 12px 10px; cursor: pointer; }
  .goal input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .goal .gt { display: block; font-size: 14px; font-weight: 500; line-height: 1.3; }
  .goal .gs { display: block; font-size: 11.5px; color: var(--muted); margin-top: 2px; line-height: 1.35; }
  .goal:hover { border-color: var(--fg); }
  .goal:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); }
  .goal:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  .rank-section { border-top: 0; padding-top: clamp(20px, 3vw, 32px); }
  .rank-section h2 { margin-bottom: 0; }
  .short { margin: 16px 0 4px; padding: 12px 14px; border: 1px solid var(--accent); border-radius: var(--radius); background: var(--accent-soft); font-size: 14.5px; max-width: 96ch; }
  .short:empty, .syn-note:empty { display: none; }
  .syn { margin-top: 14px; min-width: 900px; }
  .syn th { vertical-align: bottom; }
  .syn th span { display: block; text-transform: none; letter-spacing: 0; font-weight: 400; font-size: 11px; }
  .syn :global(th.act) { color: var(--fg); box-shadow: inset 0 -2px 0 var(--fg); }
  .syn :global(td) { padding: 9px 12px; vertical-align: middle; }
  .syn :global(td.r) { text-align: right; }
  .syn :global(.rk) { width: 34px; color: var(--muted); font-size: 12.5px; text-align: right; }
  .syn :global(.cv) { display: block; font-size: 13.5px; white-space: nowrap; }
  .syn :global(.csub) { display: block; font-size: 11px; color: var(--muted); white-space: nowrap; }
  .syn :global(.cbar) { display: block; height: 4px; background: var(--track); border-radius: 2px; margin-top: 5px; }
  .syn :global(.cbar i) { display: block; height: 100%; background: var(--bar); border-radius: 2px; margin-left: auto; }
  .syn :global(td.good) { background: var(--accent-soft); }
  .syn :global(td.good .cbar i) { background: var(--accent); }
  .syn :global(td.bad) { background: var(--warn-bg); }
  .syn :global(td.na) { color: var(--muted); }
  .syn :global(td.act .cv) { font-size: 15px; font-weight: 600; }
  .syn :global(.tn) { font-weight: 500; }
  .syn :global(.tc) { display: block; font-size: 11.5px; color: var(--muted); }
  .syn :global(td.lang) { font-size: 12.5px; color: var(--muted); }
  .syn :global(td.lang.en) { color: var(--warn-fg); }
  .syn :global(tr.me td) { border-top: 2px solid var(--fg); border-bottom: 2px solid var(--fg); }
  .syn :global(tr.me .tn) { font-weight: 700; }
  .syn-note { max-width: 100ch; }
  .legend { font-size: 11.5px; color: var(--muted); margin-top: 12px; }
  .prog-dot, .syn :global(.prog-dot) { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-left: 6px; vertical-align: middle; }
  .legend .prog-dot { margin-left: 0; margin-right: 4px; }

  .today { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(24px, 5vw, 56px); align-items: start; }
  .today .eyebrow { margin-bottom: 12px; }
  .result { padding: 6px 22px 18px; }
  .tiles { display: grid; gap: 0; }
  .tile { padding: 12px 0 13px; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto; column-gap: 16px; align-items: baseline; }
  .tl { font-size: 13px; font-weight: 500; }
  .tv { font-size: 26px; font-weight: 500; letter-spacing: -0.03em; line-height: 1.1; text-align: right; white-space: nowrap; }
  .tv small { font: 400 13px var(--font-ui); color: var(--muted); margin-left: 4px; letter-spacing: 0; }
  .ts { grid-column: 1 / -1; font-size: 12px; color: var(--muted); margin-top: 3px; }
  .tile.first .tv { font-size: 34px; color: var(--accent); }
  .notes { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 6px; max-width: 56ch; }
  .notes :global(li) { font-size: 13px; color: var(--warn-fg); background: var(--warn-bg); border: 1px solid var(--warn-line); border-radius: var(--radius); padding: 8px 11px; }
  .cities { margin-top: 6px; }
  .city-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .city-rows :global(li) { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr) 46px; gap: 10px; align-items: baseline; font-size: 13px; }
  .city-rows :global(.name) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .city-rows :global(.rent) { font-size: 11.5px; color: var(--muted); text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .city-rows :global(.v) { text-align: right; font-size: 12.5px; }
  .rank-title { font: 500 12px var(--font-num); color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin: 18px 0 10px; }
  .src { font-size: 11.5px; color: var(--muted); margin: 16px 0 0; }

  .findings { margin-top: 28px; gap: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .finding { padding: 22px 22px 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--panel); display: flex; flex-direction: column; }
  .fig { font-size: 30px; font-weight: 500; letter-spacing: -0.03em; color: var(--accent); line-height: 1.1; }
  .finding h3 { margin: 12px 0 8px; }
  .finding .muted { font-size: 14.5px; }
  .fsrc { font-size: 11px; color: var(--muted); margin-top: auto; padding-top: 14px; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }

  @media (max-width: 860px) {
    .steps-grid, .today { grid-template-columns: minmax(0, 1fr); }
    .hero h1 { max-width: none; }
  }
</style>
