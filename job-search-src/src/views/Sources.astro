---
import Base from '../layouts/Base.astro';
import { useT, type Lang } from '../i18n/ui';
import refs from '../data/references.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const h = {
  official: { en: 'Statistical offices and institutions', fr: 'Offices statistiques et institutions' },
  research: { en: 'Research and other references', fr: 'Recherche et autres références' },
  note: {
    en: 'Every source linked in the written report, retrieved on 22 November 2026. Labels are kept as cited in the report, which is written in French.',
    fr: 'Toutes les sources liées dans le rapport écrit, consultées le 22 novembre 2026.',
  },
} as const;
const groups = (['official', 'research'] as const).map((kind) => ({ kind, items: refs.filter((r) => r.kind === kind) }));
---
<Base lang={lang} route="/sources" title={t('sources.title')}>
  <section class="section first">
    <div class="container">
      <h1>{t('sources.title')}</h1>
      <p class="lead">{t('sources.lead')}</p>
      <p class="muted note">{h.note[lang]}</p>
    </div>
  </section>
  {groups.map((g) => (
    <section class="section">
      <div class="container">
        <h2>{h[g.kind][lang]} <span class="num count">{g.items.length}</span></h2>
        <ul class="refs">
          {g.items.map((r) => (
            <li>
              <span class="pub num">{r.publisher ?? r.host}</span>
              <a href={r.url} rel="noopener">{r.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>

<style>
  .first { border-top: 0; }
  h1 { margin-bottom: 16px; }
  .note { font-size: 14px; margin-top: 14px; max-width: 72ch; }
  .count { font-size: 13px; color: var(--muted); font-weight: 400; margin-left: 6px; letter-spacing: 0; }
  .refs { list-style: none; margin: 20px 0 0; padding: 0; columns: 2; column-gap: 40px; }
  .refs li { break-inside: avoid; padding: 9px 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: 150px 1fr; gap: 12px; font-size: 14px; }
  .pub { font-size: 11.5px; color: var(--muted); padding-top: 2px; overflow-wrap: anywhere; }
  @media (max-width: 820px) { .refs { columns: 1; } }
  @media (max-width: 480px) { .refs li { grid-template-columns: 1fr; gap: 2px; } }
</style>
