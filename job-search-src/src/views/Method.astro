---
import Base from '../layouts/Base.astro';
import { useT, type Lang, type Key } from '../i18n/ui';
import { ranking, statusLabel, caveats, grades } from '../data/method';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const h = {
  rank: { en: 'Which indicators, in what order', fr: 'Quels indicateurs, dans quel ordre' },
  rankLead: {
    en: 'Research on job search treats the speed at which unemployed people find work as the direct measure of difficulty. Everything else is a proxy, more or less distant. The order below is this study’s reading of that literature, not a published standard.',
    fr: "La recherche sur l'accès à l'emploi tient la vitesse à laquelle les chômeurs retrouvent un emploi pour la mesure directe de la difficulté. Tout le reste en est une approximation, plus ou moins lointaine. L'ordre ci-dessous est la lecture que fait cette étude de cette littérature, pas une norme publiée.",
  },
  colInd: { en: 'Indicator', fr: 'Indicateur' },
  colMeasures: { en: 'What it measures', fr: 'Ce qu’il mesure' },
  colLimit: { en: 'What it misses', fr: 'Ce qu’il ne mesure pas' },
  colStatus: { en: 'In this study', fr: 'Dans cette étude' },
  caveats: { en: 'Reading the figures', fr: 'Lire les chiffres' },
  grades: { en: 'Reliability marks', fr: 'Marques de fiabilité' },
  gradesLead: {
    en: 'Each figure on the site carries one of these marks.',
    fr: 'Chaque chiffre du site porte une de ces marques.',
  },
} as const;
---
<Base lang={lang} route="/method" title={t('method.title')}>
  <section class="section first">
    <div class="container">
      <h1>{t('method.title')}</h1>
      <p class="lead">{t('method.lead')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2">
        {[1, 2, 3, 4].map((n) => (
          <div class="panel">
            <span class="num n">0{n}</span>
            <h3>{t(`method.p${n}.t` as Key)}</h3>
            <p class="muted">{t(`method.p${n}.p` as Key)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{h.rank[lang]}</h2>
      <p class="lead">{h.rankLead[lang]}</p>
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th>#</th>
              <th>{h.colInd[lang]}</th>
              <th>{h.colMeasures[lang]}</th>
              <th>{h.colLimit[lang]}</th>
              <th>{h.colStatus[lang]}</th>
            </tr>
          </thead>
          <tbody>
            {ranking.map((r, k) => (
              <tr>
                <td class="num muted">{k + 1}</td>
                <td class="ind">{r.indicator[lang]}</td>
                <td>{r.measures[lang]}</td>
                <td class="muted">{r.limit[lang]}</td>
                <td><span class={`tag ${r.status === 'site' ? 'prog' : ''}`}>{statusLabel[r.status][lang]}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{h.caveats[lang]}</h2>
      <ul class="caveats">
        {caveats.map((c) => <li>{c[lang]}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{h.grades[lang]}</h2>
      <p class="lead">{h.gradesLead[lang]}</p>
      <dl class="grades">
        {grades.map((g) => (
          <div>
            <dt class="num">{g.mark}</dt>
            <dd>{g.text[lang]}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .first { border-top: 0; }
  h1 { margin-bottom: 16px; }
  .lead { margin-bottom: 24px; max-width: 72ch; }
  .n { color: var(--accent); font-size: 13px; }
  h3 { margin: 8px 0; }
  .panel p { font-size: 15px; }
  table.data td { min-width: 150px; }
  table.data td:first-child { min-width: 0; }
  .ind { font-weight: 600; }
  .caveats { margin: 0; padding: 0; list-style: none; display: grid; gap: 0; max-width: 80ch; }
  .caveats li { padding: 14px 0 14px 18px; border-top: 1px solid var(--line); position: relative; }
  .caveats li::before { content: ''; position: absolute; left: 0; top: 24px; width: 6px; height: 6px; background: var(--accent); border-radius: 1px; }
  .grades { margin: 0; display: grid; gap: 0; max-width: 80ch; }
  .grades div { display: grid; grid-template-columns: 170px 1fr; gap: 16px; padding: 12px 0; border-top: 1px solid var(--line); }
  .grades dt { font-size: 13px; }
  .grades dd { margin: 0; color: var(--muted); }
  @media (max-width: 560px) { .grades div { grid-template-columns: 1fr; gap: 2px; } }
</style>
